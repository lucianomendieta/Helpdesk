@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Helpdesk.Web.Models


@inject ITicketService ticketService;
@inject ISnackbar snackbar;
@inject IDialogService dialogService;
@inject NavigationManager navigation;
@inject IConfiguracionService ConfiguracionService;

@page "/"
@attribute [Authorize];


@if (cargando)
{
    <MudSkeleton/> 
}
else if (stats is null)
{
    <MudAlert Severity="Severity.Error">
        No se pudo obtener tus tickets, contacte a soporte.
    </MudAlert>
}
else
{
    <MudContainer>
        <MudGrid>
            @*------------------------SALUDOS-----------------------*@
            <MudItem xs="12">
                <AuthorizeView Roles="Cliente">
                    <Authorized>
                        @*Saludo al cliente y le digo cuantos tickets en total tiene*@
                        <MudStack>
                            <MudText Style="font-weight: 700; font-size: 26px; color: #221F1A">Hola, @context.User.Identity?.Name @saludoEmpresa(configuracion?.NombreEmpresa)</MudText>
                            <MudText Style="font-size: 14.5px; color: #756F63">@($"Tenes {stats.Total} tickets registrados! Asi esta el estado de tus tickets:")</MudText>
                        </MudStack>
                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Agente,Analista">
                    <Authorized>
                        @*Saludo al agente, le digo si tiene pendientes y su total*@
                        <MudStack>
                            <MudText Style="font-weight: 700; font-size: 26px; color: #221F1A">Hola, @context.User.Identity?.Name @saludoEmpresa(configuracion?.NombreEmpresa)</MudText>
                            <MudText Style="font-size: 14.5px; color: #756F63">@($"Tienes {stats.Total} tickets asignados! {pendingStatsAsk(stats.Pendiente)}")</MudText>
                        </MudStack>

                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Administrador,Gerente">
                    <Authorized>
                        @*Saludo al admin, le digo si tiene pendientes y su total*@
                        <MudStack>
                            <MudText Style="font-weight: 700; font-size: 26px; color: #221F1A">Hola, @context.User.Identity?.Name
                                @(saludoEmpresa(configuracion?.NombreEmpresa) ?? "Configure el nombre de su empresa en Configuracion")</MudText>

                            <MudText Style="font-size: 14.5px; color: #756F63">@($"Resumen general del sistema - " +
                                $"{sinasignarStats(stats.SinAsignar)}")</MudText>
                        </MudStack>
                    </Authorized>
                </AuthorizeView>
            </MudItem>
            
            @* ---- COLUMNA IZQUIERDA (8) ---- *@
            <MudItem xs="12" md="8">

                @*------------KPIs por rol--------------*@
                <AuthorizeView Roles="Cliente">
                    <Authorized>
                        @*barra de estados y creado de ticket*@
                        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-4 mb-4">
                            @*Boton para crear un ticket nuevo*@
                            <MudButton StartIcon="@Icons.Material.Filled.Add"
                                       Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="CrearTicketAsync"
                                       Style="background:var(--mud-palette-primary); 
                                   color:#fff; 
                                   font-weight:700; 
                                   border-radius:13px; 
                                   padding:15px 22px; 
                                   box-shadow:0 4px 12px;">
                                Crear Ticket
                            </MudButton>

                            @*Barra de estados*@
                            <MudStack Row="true">
                                @ticketStatChip(stats.Abierto, EstadoTicket.Abierto)
                                @ticketStatChip(stats.EnProgreso, EstadoTicket.EnProgreso)
                                @ticketStatChip(stats.Cerrado, EstadoTicket.Cerrado)
                            </MudStack>

                        </MudStack>
                    </Authorized>
                </AuthorizeView>
                
                <AuthorizeView Roles="Agente,Analista">

                    @*Barra de estados*@
                    <MudGrid Class="pa-4">
                        @ticketStatsCard(stats.Abierto, EstadoTicket.Abierto)
                        @ticketStatsCard(stats.EnProgreso, EstadoTicket.EnProgreso)
                        @ticketStatsCard(stats.Pendiente, EstadoTicket.Pendiente)
                        @* Si esta habilitado la fecha de vecimiento se reemplazan por los tickets cerrados - menor importancias*@
                        @if (configuracion?.UsarFechaVencimiento == true)
                        {
                            @statCard(Icons.Material.Filled.Schedule, stats.VencenHoy, "Vencen Hoy", "background:var(--estado-cerrado-bg); color:var(--estado-cerrado-txt)")
                        }
                        else
                        {
                            @ticketStatsCard(stats.Cerrado, EstadoTicket.Cerrado)
                        }
                    </MudGrid>

                </AuthorizeView>

                <AuthorizeView Roles="Administrador,Gerente">

                    @*Barra de estados*@
                    <MudGrid Class="pa-4">
                        @ticketStatsCard(stats.Abierto, EstadoTicket.Abierto)
                        @ticketStatsCard(stats.EnProgreso, EstadoTicket.EnProgreso)
                        @statCard(Icons.Material.Filled.PersonOff, stats.SinAsignar, "Sin Asignar", "background:var(--estado-cerrado-bg); color:var(--estado-cerrado-txt)")
                        @if (configuracion?.UsarFechaVencimiento == true)
                        {
                            @statCard(Icons.Material.Filled.Schedule, stats.VencenHoy, "Vencen Hoy", "background:var(--alerta-bg); color:var(--alerta-txt)")
                        }
                        else
                        {
                            @ticketStatsCard(stats.Cerrado, EstadoTicket.Cerrado)
                        }

                    </MudGrid>

                </AuthorizeView>

                @if (ticketsRecientes is null)
                {
                    <MudAlert Severity="Severity.Error"> No se pudieron cargar los tickets recientes</MudAlert>
                }
                else if (ticketsRecientes.Length == 0)
                {
                    <MudText> No tenes tickets todavia!</MudText>
                }
                else
                {
                    <MudPaper Elevation="0" Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px">
                        <MudTable T=TicketDto Items="ticketsRecientes"
                                  Hover="true"
                                  OnRowClick="@(fila => navigation.NavigateTo($"tickets/{fila.Item!.Id}"))">

                            @*--------------TITULO DE TABLAS------------------------*@
                            <ToolBarContent>
                                <AuthorizeView Roles="Cliente">
                                    <MudText Typo="Typo.h6">Mis tickets</MudText>
                                </AuthorizeView>
                                <AuthorizeView Roles="Agente,Analista">
                                    <MudText Typo="Typo.h6">Asignados a mi</MudText>
                                </AuthorizeView>
                                <AuthorizeView Roles="Administrador,Gerente">
                                    <MudText Typo="Typo.h6">Tickets Recientes</MudText>
                                </AuthorizeView>

                                <MudSpacer/>

                                @*----------------BOTON DE CREAR TICKET EN TABLA-------------------------*@
                                <AuthorizeView Roles="Agente,Analista,Administrador,Gerente">
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="CrearTicketAsync">
                                        Nuevo Ticket
                                    </MudButton>
                                </AuthorizeView>
                            </ToolBarContent>

                            @*-----------------------------Cabeceras---------------------------------------*@
                            <HeaderContent>
                                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; 
                                text-transform:uppercase; letter-spacing:.03em">
                                    Titulo
                                </MudTh>
                                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; 
                                text-transform:uppercase; letter-spacing:.03em">
                                    Categoria
                                </MudTh>
                                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; 
                                text-transform:uppercase; letter-spacing:.03em">
                                    Estado
                                </MudTh>
                                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; 
                                text-transform:uppercase; letter-spacing:.03em">
                                    Fecha
                                </MudTh>

                            </HeaderContent>

                            @*----------------------------------DATOS DE TABLA-------------------------------*@
                            <RowTemplate>
                                <MudTd DataLabel="Titulo">@context.Titulo</MudTd>
                                <MudTd DataLabel="Categoria">
                                    @if (context.CategoriaIcono is not null)
                                    {
                                        <MudIcon Icon="@CategoriaIconHelper.ObtenerCategoria2Icon(context.CategoriaIcono!)" Size="Size.Small"/>
                                    }
                                    else
                                    {
                                        <MudText>Sin Categoria</MudText>
                                    }

                                </MudTd>
                                <MudTd DataLabel="Estado">
                                    <MudChip T="string" Color="@context.Estado.GetColor()"
                                             Style="@context.Estado.ChipStyle(padding:"11px 16px", radius:"12px", fontSize:"13px")">
                                        @context.Estado
                                    </MudChip>
                                </MudTd>

                                <MudTd DataLabel="Fecha">@context.FechaCreacion.ToString("dd MMM")</MudTd>

                            </RowTemplate>
                        </MudTable>
                    </MudPaper>
                }
            </MudItem>
            @* ---- COLUMNA DERECHA (4) ---- *@
            <MudItem xs="12" md="4">
                <MudStack>
                    @*----------------------------------Grafico Donut------------------------------------------------*@
                    <MudPaper Elevation="0" Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:20px ">
                        <MudText Style="font-size:16px; font-weight:600; color:#221F1A; align-self:flex-start">
                            Distribucion por estado
                        </MudText>
                        @*Si no hay datos del donut, no se muestra nada*@
                        @if (donutData.Length == 0)
                        {
                            <MudText>Sin tickets para mostrar</MudText>
                        }
                        else
                        {
                            <div style="display:flex; justify-content:center; margin-top:16px;">
                                <MudChart T="double" ChartType="ChartType.Donut"
                                          ChartSeries="donutSeries"
                                          ChartLabels="donutLabels"/>
                            </div>

                        }
                    </MudPaper>

                    @*-----------------------------------accesos rapidos-------------------------------------------*@
                    <MudPaper Elevation="0" Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:18px ">
                        <MudText Style="font-size: 16px; font-weight: 600; color: #221F1A; margin-bottom: 12px"> Accesos Rapidos </MudText>
                        <MudStack>
                            @*-------------------Solo para cliente*@
                            <AuthorizeView Roles="Cliente">
                                <Authorized>
                                    @accesoRapido(Icons.Material.Filled.Add, "Crear Ticket",
                                        () => CrearTicketAsync(), true)
                                    @accesoRapido(Icons.Material.Filled.Assignment, "Mis Tickets",
                                        () => navigation.NavigateTo("/tickets"), false)
                                </Authorized>
                            </AuthorizeView>

                            @*------------------Solo para agentes*@
                            <AuthorizeView Roles="Agente,Analista">
                                <Authorized>
                                    @accesoRapido(Icons.Material.Filled.PersonSearch, "Ver mis Tickets",
                                        () => navigation.NavigateTo("/tickets/mios"), true)
                                </Authorized>
                            </AuthorizeView>

                            @*-----------------Solo para Administradores*@
                            <AuthorizeView Roles="Administrador,Gerente">
                                <Authorized>
                                    @accesoRapido(Icons.Material.Filled.Add, "Crear Ticket",
                                        () => CrearTicketAsync(), true)
                                    @accesoRapido(Icons.Material.Filled.PersonOff, "Tickets sin asignar",
                                        () => navigation.NavigateTo("/tickets/sinasignar"), false)
                                    @accesoRapido(Icons.Material.Filled.People, "Gestionar usuarios",
                                        () => navigation.NavigateTo("/usuarios"), false)

                                </Authorized>
                            </AuthorizeView>
                        </MudStack>
                    </MudPaper>
                </MudStack>

            </MudItem>
        </MudGrid>
    </MudContainer>
    
       
}




@code {
    private TicketsStatsDto? stats;
    private bool cargando = true;
    private double[] donutData = [];
    private string[] donutLabels = [];
    private List<ChartSeries<double>> donutSeries = [];
    private TicketDto[]? ticketsRecientes;
    
    //configuracion
    private ConfiguracionResponseDto? configuracion;

    protected override async Task OnInitializedAsync()
    {
        stats = await ticketService.GetTicketsStatsAsync();
        ticketsRecientes = await ticketService.GetTicketsRecientesAsync();
        configuracion = await ConfiguracionService.GetConfiguracionAsync();
            
        if (stats is null)
        {
            snackbar.Add("No se pudo obtener tus tickets, contacte a soporte.", Severity.Error);
        }
        else
        {
            //Inicializo la lista de pares
            var paresStats = new List<(EstadoTicket estado, int cantidad)>
            {
                (EstadoTicket.Abierto, stats.Abierto),
                (EstadoTicket.EnProgreso, stats.EnProgreso),
                (EstadoTicket.Hecho, stats.Hecho),
                (EstadoTicket.Pendiente, stats.Pendiente),
                (EstadoTicket.Cerrado, stats.Cerrado)
            };
            var conDatos = paresStats.Where(p => p.cantidad > 0).ToList();

            //Para los datos selecciono su cantidad, para estado lo paso a string
            donutData = conDatos.Select(cd => (double)cd.cantidad).ToArray();
            donutLabels = conDatos.Select(cd => cd.estado.ToString()).ToArray();

            donutSeries = new List<ChartSeries<double>>
            {
                new ChartSeries<double> { Name = "Tickets", Data = donutData}
            };
        }

        cargando = false;

    }

    private async Task CrearTicketAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth=MaxWidth.Medium, FullWidth=true};
        DialogParameters<CrearTicketDialog> parameters = new()
        {
            { x => x.usarFechaVencimiento, configuracion?.UsarFechaVencimiento ?? false }
        };
        var dialog = await dialogService.ShowAsync<CrearTicketDialog>("Nuevo Ticket", parameters, options);

        var result = await dialog.Result;

        //Si no se cancelo, creo el ticket y viajo al detalle
        if (result?.Data is TicketDto nuevo)
        {
            navigation.NavigateTo($"tickets/{nuevo.Id}");
        }
    }

    #region Renders
    //================================RENDERS========================================
    //Para no repetir los chips, tood en la misma estructura
    private RenderFragment ticketStatChip(int Cantidad, EstadoTicket Estado) =>
        @<MudChip T="string" 
                  Style="@Estado.ChipStyle(padding:"11px 16px", radius:"12px", fontSize:"13px")">
            @*Si es mas de uno se pluraliza*@
            @Cantidad @(pluralStats(Cantidad, Estado))
        </MudChip>
    ;

    private RenderFragment accesoRapido(string icon, string label, Action onClick, bool esPrimario) =>
        @<div @onclick="onClick" style="@($"display:flex; " +
                                        $"align-items:center; " +
                                        $"gap:10px; padding:11px 12px; border-radius:10px; " +
                                        $"cursor:pointer; " +
                                        $"background:{(esPrimario ? "var(--accent-soft)" : "#F8F5EE")}")">
            <MudIcon Icon="@icon" Style="@($"color: {(esPrimario ? "var(--mud-palette-primary)" : "#756F63")}")"/>
            <span style="font-size: 13px; font-weight: 600; color:#221F1A">@label</span>
        </div>;
    
    //Fragment para agentes y admins
    private RenderFragment ticketStatsCard(int cantidad, EstadoTicket estado) =>
        statCard(estado.GetIcons(), cantidad, pluralStats(cantidad, estado), estado.ChipStyle(padding:"11px 16px", radius:"12px", fontSize:"13px"));
    
    //Cards de estadisticas
    private RenderFragment statCard(string icon, int cantidad, string label, string colorStyle) =>
        @<MudItem xs="12" sm="6" md="3">
            <MudPaper Elevation="0" Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:18px;">
                <MudStack>
                    <MudAvatar Style="@colorStyle">
                        <MudIcon Icon="@icon"/>
                    </MudAvatar>
                </MudStack>
                <MudStack Spacing="2">
                    <MudText Style="font-size:26px; font-weight:700; color:#221F1A">@cantidad</MudText>
                    <MudText Style="font-size:13px; color:#756F63">@label</MudText>
                </MudStack>
            </MudPaper>
        </MudItem>;
    #endregion

    #region funciones
    //============================Funciones================================
    //Pluralizo los estados
    string pluralStats(int Cantidad, EstadoTicket estado)
    {
        if (Cantidad != 1 && estado is not EstadoTicket.EnProgreso)
        {
            return estado + "s";
        }
        else
        {
            return estado.ToString();
        }
    }

    //Condicion si hay pendientes se muestra para el usuario (agente o admins)
    string pendingStatsAsk(int pendientes)
    {
        if (pendientes > 1)
        {
            return $"Tienes {pendientes} tickets pendientes.";
        }
        else if (pendientes == 1)
        {
            return $"Tienes {pendientes} ticket pendiente.";
        }
        else
        {
            return "No tienes tickets pendientes!";
        }
    }

    //Si hay tickets sin asignar
    string sinasignarStats(int Cantidad)
    {
        if (Cantidad > 1)
        {
            return $"{Cantidad} tickets sin asignar requieren atencion.";
        }
        else if (Cantidad == 1)
        {
            return $"{Cantidad} ticket sin asignar, echa un vistazo.";
        }
        else
        {
            return "Todos los tickets tienen asignacion!";
        }
    }

    //Saludo de empresa si existe configuracion
    string? saludoEmpresa(string? empresa)
    {
        if (empresa is null)
        {
            return null;
        }
        else
        {
            return $" - {empresa}";
        }
    }
    
   

    #endregion


}
