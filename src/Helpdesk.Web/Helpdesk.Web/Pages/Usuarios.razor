@using Helpdesk.Web.Components;
@using Helpdesk.Web.Dtos;
@using Helpdesk.Web.Helpers;
@using Helpdesk.Web.Services;
@using Microsoft.AspNetCore.Authorization

@inject IUsuarioService usuarioService
@inject IDialogService dialogService;
@inject ISnackbar snackbar;

@page "/usuarios"
@attribute [Authorize(Roles = "Administrador,Gerente")]

<MudContainer>

    <MudStack Row="true" AlignItems="AlignItems.Center" Style="margin-bottom:24px">
        <MudText Style="font-size:25px; font-weight:700; color:#221F1A">Usuarios</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="OpenDialogAsync"
                   Style="border-radius:11px; padding:11px 22px; font-size:13px; font-weight:700; text-transform:none">
            Crear Usuario
        </MudButton>
    </MudStack>

    <div style="background:#fff; border:2px solid var(--borde-sutil); border-radius:16px; overflow:hidden">
        <MudTable T="UsuarioDto"
                  Items="users ?? []"
                  Hover="true"
                  Dense="true"
                  Loading="users is null">
            <HeaderContent>
                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px">Usuario</MudTh>
                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px">Email</MudTh>
                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px">Rol</MudTh>
                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px">Estado</MudTh>
                <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px">Acciones</MudTh>
            </HeaderContent>
            <RowTemplate>
                @* Avatar + nombre completo + username *@
                <MudTd>
                    <div style="display:flex; align-items:center; gap:10px">
                        <MudAvatar Size="Size.Small"
                                   Style="background:var(--accent-soft); color:var(--mud-palette-primary); font-size:12px; font-weight:700">
                            @InicialHelper.InicialesHelper($"{context.NombrePila} {context.ApellidoPila}".Trim())
                        </MudAvatar>
                        <div>
                            <div style="font-size:13px; font-weight:600; color:#221F1A">@context.NombrePila @context.ApellidoPila</div>
                            <div style="font-size:11.5px; color:#948C7D">@context.Nombre</div>
                        </div>
                    </div>
                </MudTd>

                <MudTd>
                    <span style="font-size:13px; color:#756F63">@context.Email</span>
                </MudTd>

                @* Rol: chip neutro gris *@
                <MudTd>
                    <span style="font-size:11.5px; font-weight:600; color:#756F63; background:#EDE9DF; padding:4px 10px; border-radius:20px">
                        @context.Rol
                    </span>
                </MudTd>

                @* Estado: verde activo / gris inactivo *@
                <MudTd>
                    @if (context.Estado == EstadoUsuario.Activo)
                    {
                        <span style="font-size:11.5px; font-weight:600; color:var(--estado-hecho-txt); background:var(--estado-hecho-bg); padding:4px 10px; border-radius:20px">Activo</span>
                    }
                    else
                    {
                        <span style="font-size:11.5px; font-weight:600; color:var(--estado-cerrado-txt); background:var(--estado-cerrado-bg); padding:4px 10px; border-radius:20px">Inactivo</span>
                    }
                </MudTd>

                @* Acciones: sin Color.Secondary ni Color.Warning *@
                <MudTd @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Key"
                                   Style="color:#756F63"
                                   OnClick="@(() => ShowResetPasswordDialogAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                   Style="color:var(--mud-palette-primary)"
                                   OnClick="@(() => ShowUpdateDialogAsync(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                   Style="color:var(--alerta-txt)"
                                   OnClick="@(() => ShowDeleteDialogAsync(context.Id))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager PageSizeOptions="new int[] {5, 10, 25}"
                               RowsPerPageString="Filas por página:"
                               InfoFormat="{first_item}-{last_item} de {all_items}" />
            </PagerContent>
        </MudTable>
    </div>

</MudContainer>


@code {
    private UsuarioDto[]? users;


    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };

        var dialog = await dialogService.ShowAsync<CrearUsuarioDialog>("Nuevo Usuario", options);

        var result = await dialog.Result;
        if (result?.Data is UsuarioDto nuevo)
        {
            users = users?.Append(nuevo).ToArray();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        users = await usuarioService.GetUsuariosAsync();
    }

    private async Task ShowUpdateDialogAsync(UsuarioDto usuarioAEditar)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<PutUsuarioDialog> { { x => x.usuario, usuarioAEditar } };
        var dialog = await dialogService.ShowAsync<PutUsuarioDialog>("Editar usuario", parameters, options);

        var result = await dialog.Result;
        if (result?.Data is UsuarioDto edit)
        {
            users = users?.Select(u => u.Id == edit.Id ? edit : u).ToArray();
        }
    }

    private async Task ShowDeleteDialogAsync(int id)
    {
        bool? result = await dialogService.ShowMessageBoxAsync(
            title: "Atención",
            message: "¿Seguro que querés borrar el usuario?",
            yesText: "Borrar",
            cancelText: "Cancelar"
        );

        if (result == true)
        {
            var ok = await usuarioService.DeleteUsuarioAsync(id);
            if (ok == true)
            {
                users = users?.Where(u => u.Id != id).ToArray();
            }
            else
            {
                snackbar.Add("No se pudo eliminar el usuario", Severity.Error);
            }
        }
    }

    private async Task ShowResetPasswordDialogAsync(UsuarioDto usuarioAEditar)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true };
        var parameters = new DialogParameters<ResetPasswordDialog> { { x => x.usuario, usuarioAEditar } };
        var dialog = await dialogService.ShowAsync<ResetPasswordDialog>("Reiniciar contraseña", parameters, options);

        var result = await dialog.Result;
        if (result?.Data is true)
        {
            snackbar.Add("Se ha reiniciado la contraseña con éxito", Severity.Success);
        }
    }
}
