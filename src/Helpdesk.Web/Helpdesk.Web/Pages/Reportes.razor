@page "/reportes"
@using System.Globalization
@using System.Runtime.InteropServices.JavaScript
@using Microsoft.AspNetCore.Authorization
@using _Imports = MudBlazor._Imports

@attribute [Authorize(Roles = "Administrador,Gerente")]

@inject IReportesService ReportesService;
@inject IConfiguracionService ConfiguracionService;
@inject ISnackbar snackbar;
@inject DescargaInterop DescargaInterop;

@if (cargando)
{
    <MudSkeleton />
}
else if (reporte is null)
{
    <MudAlert Severity="Severity.Error">
        No se pudo obtener los reportes, contacte a soporte.
    </MudAlert>
}
else
{
    <MudContainer>
        @*============================CABECERA=========================================*@
        <MudStack Row="true" AlignItems="AlignItems.Start">
            <MudStack>
                <MudText Style="font-size:26px;font-weight:700;color:#221F1A">Reportes</MudText>
                <MudText Style="font-size: 13.5px; color: #756F63; margin-top: 2px">@configuracion?.NombreEmpresa - Vista solo lectura</MudText>
            </MudStack>
            <MudSpacer/>
            
            <MudStack Row="true" AlignItems="AlignItems.Center">
                @*DESDE*@
                <div class="reporte-fecha-picker" style="border:1.5px solid rgba(33,29,24,.12); border-radius:10px; 
                                padding:9px 13px; background:#fff; display: flex; align-items: center; gap: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Style="font-size: 16px; color: #948C7D"/>
                    <span style="font-size: 12px; color:#948C7D">Desde</span>
                    <MudDatePicker Date="desdeSelected"
                                   DateChanged="OnDesdeChanged"
                                   Variant="Variant.Text"
                                   Underline="false"
                                   Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy"
                                   Adornment="Adornment.None"
                                   Class="pa-0"/>
                </div>
                
                
                @*HASTA*@
                <div class="reporte-fecha-picker" style="border:1.5px solid rgba(33,29,24,.12); border-radius:10px; 
                                padding:9px 13px; background:#fff; display: flex; align-items: center; gap: 8px;">
                    <MudIcon Icon="@Icons.Material.Filled.CalendarToday" Style="font-size: 16px; color: #948C7D"/>
                    <span style="font-size: 12px; color:#948C7D">Hasta</span>
                    <MudDatePicker Date="hastaSelected" 
                                   DateChanged="OnHastaChanged"
                                   Variant="Variant.Text"
                                   Underline="false"
                                   Margin="Margin.Dense"
                                   DateFormat="dd/MM/yyyy"
                                   Adornment="Adornment.None"
                                   Class="pa-0"/>
                </div>
                
                
                @*EXPORTAR*@
                <MudButton StartIcon="@Icons.Material.Filled.PictureAsPdf"
                           OnClick="ExportarPdfAsync"
                           Disabled="exportando"
                           Style="border:1.5px solid rgba(33,29,24,.14); border-radius:10px; padding:10px 15px; 
                           font-size: 13px; font-weight: 600; color:#221F1A; text-transform: none">
                    Exportar a PDF
                </MudButton>
            </MudStack>
            
            
        </MudStack>
        
        @*==================PROMEDIO DEL PERIODO=========================   *@
        <MudPaper Style="background-color: #fff; border: 1px solid var(--borde-sutil); border-radius: 16px; 
        padding: 22px 26px; margin-bottom: 18px; margin-top: 18px; display: flex; align-items: center; gap: 22px;"> 
                <div style="border-radius: 13px; background: var(--accent-soft); width:52px; height:52px; display:flex; align-items:center; justify-content:center">
                    <MudIcon Icon="@Icons.Material.Filled.Timer" Style="font-size: 28px; color: var(--mud-palette-primary)"/>
                </div>
                @*CONTADOR DE PROMEDIO*@
                <MudStack>
                    @if (reporte.TiempoResolucion.PromedioDias == null)
                    {
                        <MudChip T="string" Color="Color.Error">Sin tickets resueltos en el periodo</MudChip>
                    }
                    else
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Baseline">
                            <MudText Style="font-size:34px; font-weight:700; color:#221F1A">@reporte.TiempoResolucion.PromedioDias</MudText>
                            <MudText Style="font-size:15px; font-weight:600; color:#756F63"> dias promedio de resolucion</MudText>
                        </MudStack>
                    
                        <MudText Style="font-size:12.5px; color:#948C7D">Promedio sobre @reporte.TiempoResolucion.CantidadResueltos en el periodo</MudText>    
                    }
                    
                </MudStack>
        </MudPaper>
        
        @*============================POR CATEGORIAS======================*@
        <MudPaper Style="background-color:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:22px 26px; margin-bottom:18px">
            <MudText Typo="Typo.h6" Style="font-size:15px; font-weight:700; color:#221F1A; margin-bottom:2px">Volumen por categoria</MudText>
            <MudText Style="font-size:12px; color:#948C7D; margin-bottom:18px"> Tickets creados en el periodo </MudText>
            
            <div style="display: flex; flex-direction: column; gap: 13px">
                @foreach (var categoria in reporte.PorCategoria)
                {
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <MudText Style="width:190px; flex:none; font-size:12.5px; font-weight:500; color:#221F1A; line-height:1.25">@categoria.Categoria</MudText>
                        <div style="flex:1; background:#F1ECE1; border-radius:7px; height:20px; position:relative">
                            <div style="@($"height:100%; border-radius:7px; background:var(--mud-palette-primary); " +
                                        $"width:{pctCategoria(categoria.Cantidad).ToString(CultureInfo.InvariantCulture)}%")" />
                        </div>
                        <div style="width:26px; flex:none; font-size:13px; font-weight:700; color:#221F1A; text-align:right">
                            @categoria.Cantidad
                        </div>
                    </div>
                }
            </div>
            
        </MudPaper>
        
        @*=============================POR MESES==========================*@
        <MudPaper Class="ma-4">
            <MudText Typo="Typo.h6" Style="font-weight: bold">Volumen por mes</MudText>
            <MudText Typo="Typo.body1"> Tickets creados por mes </MudText>
            
            <MudChart T="double" 
                      ChartType="ChartType.Bar" 
                      ChartSeries="mesesSeries"
                      ChartLabels="labelsPorMes"
                      Width="100%"
                      Height="300px"
                      />
        </MudPaper>
        
    </MudContainer>
}


@code {
    private bool cargando = true;
    private bool exportando = false;
    private ReporteResponseDto? reporte;
    private ConfiguracionResponseDto? configuracion;
    
    //Timeline seleccionado
    private DateTime? desdeSelected;
    private DateTime? hastaSelected;
    
    //Datos para el chart de meses
    private double[] cantidadesPorMes = [];
    private string[] labelsPorMes = [];
    private List<ChartSeries<double>> mesesSeries = [];

    
    //Inicializo los datos a usar
    protected override async Task OnInitializedAsync()
    {
        configuracion = await ConfiguracionService.GetConfiguracionAsync();
        await CargarReporteAsync();
        
        cargando =  false;
        
    }

    private async Task CargarReporteAsync()
    {
        reporte = await ReportesService.GetReporteAsync(desdeSelected, hastaSelected);

        if (reporte is null)
        {
            snackbar.Add("No se pudo cargar el reporte, contacte a soporte.", Severity.Error);
            cantidadesPorMes = [];
            labelsPorMes = [];
            mesesSeries = [];
            return;
        }
        else
        {
            //Precargo el reporte de meses
            cantidadesPorMes = reporte.PorMes.Select(m => (double)m.Cantidad).ToArray();
            labelsPorMes = reporte.PorMes.Select(m => $"{m.Mes:D2}/{m.Anio}").ToArray();
            mesesSeries = new List<ChartSeries<double>>
            {
                new ChartSeries<double> { Name = "Tickets", Data = cantidadesPorMes }
            };
        }
        
    }
    
    

    private async Task OnDesdeChanged(DateTime? nuevo)
    {
        desdeSelected = nuevo;
        await CargarReporteAsync();
    }

    private async Task OnHastaChanged(DateTime? nuevo)
    {
        hastaSelected = nuevo;
        await CargarReporteAsync();
        
    }
    
    //Handler para exportar el pdf
    private async Task ExportarPdfAsync()
    {
        exportando = true;
        try
        {
            var stream = await ReportesService.GetReportePdfAsync(desdeSelected, hastaSelected);
            if (stream is null)
            {
                snackbar.Add("No se pudo descargar el pdf, vuelva a intentarlo.", Severity.Error);
                return;
            }
            
            await DescargaInterop.DescargarArchivo( stream, "reporte.pdf");
        }
        finally
        {
            exportando = false;
        }
        
    }
    
    //Helper de  linea
    private double pctCategoria(int Cantidad)
    {
        var max = reporte.PorCategoria.Max(c => c.Cantidad); //Saco el maximo de categorias
        double cantidadInt = Cantidad; //Convierto a double el entero de cantidad
        return (cantidadInt / max) * 100;  //Devuelvo el porcentaje
    }
}