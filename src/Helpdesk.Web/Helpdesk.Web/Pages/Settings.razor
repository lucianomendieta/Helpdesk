@page "/settings"
@attribute [Authorize(Roles="Administrador,Gerente")]

@using Helpdesk.Web.Models
@using Microsoft.AspNetCore.Authorization

@inject ICategoriaService categoriaService;
@inject IDialogService dialogService;
@inject ISnackbar snackbar;
@inject IConfiguracionService configuracionservice;

<MudContainer>
    <MudText Style="font-size:25px; font-weight:700; color:#221F1A; margin-bottom:24px">Configuracion</MudText>
        
    <MudPaper Elevation="0" Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:24px">
        
        @*----------------------------------Titulos y boton de crear categoria----------------------------------------*@
        <div style="display:flex; justify-content:space-between; align-items:flex-start">
            <div>
                <MudText Style=" font-size:16px; font-weight:700; color:#221F1A;  margin-bottom: 2px"> Categorias </MudText>
                <MudText Style="font-size: 13px; color: #756F63; margin-bottom: 18px">
                    Son las opciones que ve el cliente al pedir ayuda. No se borran: se desactivan.
                </MudText>
            </div>
            <MudButton
                StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenDialogAsync"
                Color="Color.Primary"
                Variant="Variant.Filled"
                Style="border-radius:11px; padding:11px 22px; font-size:13px; font-weight:700; text-transform:none">
                Crear Categoria
            </MudButton>
            
        </div>
        

        <div style="display:flex; gap:26px; align-items:flex-start">
            @*-----------------------------Tabla-------------------------------*@
            <div style="flex: 1.5">
                <div style="border: var(--borde-sutil); border-radius: 16px; overflow: hidden">
                    <MudTable T="CategoriaResponseDto"
                              Items="categorias ?? []"
                              Loading="categorias is null"
                              Dense="true">
                        @*Cabeceras y titulos de tablas*@
                        <HeaderContent>
                            <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px"><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Icono)"> Icono </MudTableSortLabel></MudTh>
                            <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px"><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Nombre)"> Nombre </MudTableSortLabel></MudTh>
                            <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px"><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Descripcion!)"> Descripcion </MudTableSortLabel></MudTh>
                            <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px"><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.PrioridadSugerida)"> Prioridad Sugerida </MudTableSortLabel></MudTh>
                            <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px"><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Activa)"> Estado </MudTableSortLabel></MudTh>
                            <MudTh Style="font-size:10.5px; color:#948C7D; font-weight:600; text-transform:uppercase; letter-spacing:.03em; padding:10px 14px"> Acciones </MudTh>

                        </HeaderContent>
                        @*Aca van los datos para la tabla*@
                        <RowTemplate>
                            <MudTd><MudIcon Icon="@CategoriaIconHelper.ObtenerCategoria2Icon(context.Icono)" Style="font-size:20px; color:#948C7D"/></MudTd>
                            <MudTd DataLabel="Nombre" Style="font-size:13px; font-weight:600; color:#221F1A">@context.Nombre</MudTd>
                            <MudTd DataLabel="Descripcion" Style="font-size:12px; color:#756F63">@context.Descripcion</MudTd>
                            <MudTd DataLabel="Prioridad Sugerida">
                                <span style="font-size:11.5px; font-weight:600; color:#756F63; background:#EDE9DF; padding:4px 10px; border-radius:20px">
                                    @context.PrioridadSugerida
                                </span>
                            </MudTd>
                            <MudTd DataLabel="Estado">
                                @if (context.Activa)
                                {
                                    <span style="color:#1E8E5A; background:#DFF3E7; padding:4px 10px; border-radius:20px; font-size:11.5px; font-weight:600"/>
                                }
                                else
                                {
                                    <span style="color:#948C7D; background:#EDE9DF; padding:4px 10px; border-radius:20px; font-size:11.5px; font-weight:600 "/>
                                }
                            </MudTd>
                            <MudTd DataLabel="Acciones">

                                <MudIconButton Icon="@(context.Activa ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                               Disabled="context.EsDelSistema"
                                               OnClick="() => ToggleEstadoAsync(context)"
                                               Style="color:#756F63"/>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               OnClick="() => EditCategoriaAsync(context)"
                                               Style="color:#756F63"/>
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            </div>
            @*-----------------------------------------------Side pannel con vista en vivo-----------------------------*@
            <div style="flex: 1;">
                <MudText Style="font-size:12px; font-weight:600; color:#756F63; margin-bottom:10px">Asi lo ve el cliente:</MudText>
                <div style="background:#fff; border:1px solid rgba(33,29,24,.1); border-radius:16px; padding:20px">
                    <MudText Style="font-size: 15px; font-weight: 700; color: #221F1A; margin-bottom: 12px"> Con que necesitas ayuda?</MudText>
                    <BotonesCategoria Categorias="CategoriasActivas"/>
                </div>
            </div>
        </div>
        
    </MudPaper>

    @*----------------------------------------------Cards 2 y 3------------------------------*@
    <div style="display: flex; gap:20px; align-items: stretch; margin-top: 20px; margin-bottom: 20px">
        
        @*--------------------------------Check de uso de fecha de vencimiento -------------------------------------*@
        <MudPaper Elevation="0" Style="flex: 1; background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:24px">
            <MudText Style="font-size: 16px; font-weight: 700; color: #221F1A">
                Preferencias de tickets
            </MudText>
            
            <div style="display: flex; justify-content: space-between; align-items: center">
                <div>
                    <MudText Style="font-size: 14px; font-weight: 600; color: #221F1A">
                        Usar fecha de vencimiento
                    </MudText>
                    <MudText Style="font-size: 12.5px; color: #756F63; margin-top: 2px">
                        Muestra un campo de vencimiento en cada ticket. Apagado por defecto.
                    </MudText>
                </div>
                <MudSwitch T="bool"
                           Value="configuracion?.UsarFechaVencimiento ?? false"
                           ValueChanged="ToggleFechaVencimientoAsync"
                           Disabled="configuracion is null"
                           Color="Color.Primary"/>
            </div>
        </MudPaper>

        @*---------------------------------------------- Nombre de la empresa -----------------------------------------*@
        <MudPaper Elevation="0" Style="flex: 1; background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:24px">
            <MudText Style="font-size: 16px; font-weight: 700; color: #221F1A">
                Empresa
            </MudText>
            <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A; margin-bottom: 6px">
                Nombre de la empresa
            </MudText>
            
            <div style="display: flex; gap: 12px; align-items: center">
                <div style="flex: 1; border: 1.5px solid rgba(33,29,24,.12); border-radius: 11px; padding-left: 14px">
                    <MudTextField T="string" @bind-Value="nombreEmpresaEditable" Variant="Variant.Text" Underline="false" Immediate="true" />
                </div>
                
                <MudButton OnClick="GuardarNombreEmpresaAsync"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Disabled="nombreEmpresaEditable == configuracion?.NombreEmpresa"
                           Style="border-radius: 10px; padding: 11px 20px; font-weight: 700; font-size: 13px; text-transform: none">
                    Guardar
                </MudButton>
            </div>
        </MudPaper>
    </div>
</MudContainer>



@code {
    private CategoriaResponseDto[]? categorias;
    private ConfiguracionResponseDto? configuracion;
    private string nombreEmpresaEditable = string.Empty;
    
    
    //Filtro las categorias activas
    private CategoriaResponseDto[]? CategoriasActivas => categorias?.Where(c => c.Activa).ToArray();
    //Inicializo los datos:
    protected override async Task OnInitializedAsync()
    {
        categorias = await categoriaService.GetCategoriasAsync();
        configuracion = await configuracionservice.GetConfiguracionAsync();
        nombreEmpresaEditable = configuracion?.NombreEmpresa ?? string.Empty;
    }
    
    
    //llamo al dialogo
    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogParameters<CrearCategoriaDialog> parameters = new()
        {
            { x => x.usarFechaVencimiento, configuracion?.UsarFechaVencimiento ?? false }
        };
        var dialog = await dialogService.ShowAsync<CrearCategoriaDialog>("Nueva categoria",parameters, options);
        
        
        var result = await dialog.Result;
        if (result?.Data is CategoriaResponseDto nuevo)
        {
            categorias = categorias?.Append(nuevo).ToArray();
        }
    }
    
    //acciones con las categorias
    private async Task ToggleEstadoAsync(CategoriaResponseDto categoria)
    {
        var dto = new ActualizarEstadoCategoriaDto() { Activa = !categoria.Activa }; //Invierto el estado
        var resultado = await categoriaService.UpdateEstadoCategoriaAsync(categoria.Id, dto);

        if (resultado.Exito)
        {
            categoria.Activa = !categoria.Activa;
        }
        else
        {
            snackbar.Add("No se pudo actualizar el estado", Severity.Error);
        }
    }

    //editar categoria
    private async Task EditCategoriaAsync(CategoriaResponseDto categoria)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogParameters<CrearCategoriaDialog> parameters = new()
        {
            { x => x.categoriaExistente, categoria },
            { x => x.usarFechaVencimiento, configuracion?.UsarFechaVencimiento ?? false }
        };

        var dialog = await dialogService.ShowAsync<CrearCategoriaDialog>("Editar categoria", parameters, options);
        var result = await dialog.Result;
    }
    
    //toggle de estado de uso fecha vencimiento en tickets
    private async Task ToggleFechaVencimientoAsync(bool nuevo)
    {
        var dto = new ActualizarFechaVencimientoDto { UsarFechaVencimiento = nuevo };
        var resultado = await configuracionservice.UpdateFechaVencimientoAsync(dto);

        if (resultado.Exito)
        {
            configuracion.UsarFechaVencimiento = nuevo;
        }
        else
        {
            snackbar.Add("No se pudo actualizar la preferencia", Severity.Error);
        }
    }
    
    //Guardo el nombre de empresa
    private async Task GuardarNombreEmpresaAsync()
    {
        var dto = new ActualizarNombreEmpresaDto { NombreEmpresa = nombreEmpresaEditable };
        var resultado = await configuracionservice.UpdateNombreEmpresaAsync(dto);
        if (resultado.Exito)
        {
            configuracion!.NombreEmpresa = nombreEmpresaEditable;
            snackbar.Add("Nombre Actualizado", Severity.Success);
        }
        else
        {
            snackbar.Add(resultado.Error ?? "No se pudo actualizar el nombre", Severity.Error);
        }
    }
    
}
