@page "/settings"
@attribute [Authorize(Roles="Administrador,Gerente")]

@using Helpdesk.Web.Models
@using Microsoft.AspNetCore.Authorization

@inject ICategoriaService categoriaService;
@inject IDialogService dialogService;
@inject ISnackbar snackbar;
@inject IConfiguracionService configuracionservice;

<MudContainer>
    
    <MudButton
        StartIcon="@Icons.Material.Filled.Add"
        OnClick="OpenDialogAsync">
        Crear Categoria
    </MudButton>
    
    <MudGrid >
        <MudItem xs="12" md="8">
            <MudTable T="CategoriaResponseDto"
                      Items="categorias ?? []"
                      Loading="categorias is null">
                @*Cabeceras y titulos de tablas*@
                <HeaderContent>
                    <MudTh><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Icono)"> Icono </MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Nombre)"> Nombre </MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Descripcion!)"> Descripcion </MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.PrioridadSugerida)"> Prioridad Sugerida </MudTableSortLabel></MudTh>
                    <MudTh><MudTableSortLabel SortBy="new Func<CategoriaResponseDto, object>(x => x.Activa)"> Estado </MudTableSortLabel></MudTh>
                    <MudTh> Acciones </MudTh>

                </HeaderContent>
                @*Aca van los datos para la tabla*@
                <RowTemplate>
                    <MudTd><MudIcon Icon="@CategoriaIconHelper.ObtenerCategoria2Icon(context.Icono)"/></MudTd>
                    <MudTd DataLabel="Nombre">@context.Nombre</MudTd>
                    <MudTd DataLabel="Descripcion">@context.Descripcion</MudTd>
                    <MudTd DataLabel="Prioridad Sugerida">@context.PrioridadSugerida</MudTd>
                    <MudTd DataLabel="Estado">@(context.Activa ? "Activa" : "Inactiva")</MudTd>
                    <MudTd DataLabel="Acciones">

                        <MudIconButton Icon="@(context.Activa ? Icons.Material.Filled.Visibility : Icons.Material.Filled.VisibilityOff)"
                                       Disabled="context.EsDelSistema"
                                       OnClick="() => ToggleEstadoAsync(context)"/>
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       OnClick="() => EditCategoriaAsync(context)"/>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudItem>
        
        @*Side pannel con vista en vivo*@
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4">
                <MudText Typo="Typo.overline" Color="Color.Secondary">Así lo ve el cliente ↓</MudText>
                <BotonesCategoria Categorias="CategoriasActivas" />
            </MudPaper>
        </MudItem>
    </MudGrid>
    @* Check de uso de fecha de vencimiento *@
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Preferencias de tickets</MudText>
        <MudSwitch T="bool"
                   Value="configuracion?.UsarFechaVencimiento ?? false"
                   ValueChanged="ToggleFechaVencimientoAsync"
                   Disabled="configuracion is null"
                   Label="Usar Fecha de vencimiento"
                   Color="Color.Primary"/>
    </MudPaper>
    @* Nombre de la empresa *@
    <MudPaper Class="pa-4 mt-4">
        <MudText Typo="Typo.h6">Empresa</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudTextField T="string" @bind-Value="nombreEmpresaEditable" Label="Nombre de la empresa" Immediate="true" />
            <MudButton OnClick="GuardarNombreEmpresaAsync"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="nombreEmpresaEditable == configuracion?.NombreEmpresa">Guardar</MudButton>
        </MudStack>
    </MudPaper>
</MudContainer>



@code {
    private CategoriaResponseDto[]? categorias;
    private ConfiguracionResponseDto? configuracion;
    private string nombreEmpresaEditable = string.Empty;
    
    //Filtro las categorias activas
    private CategoriaResponseDto[]? CategoriasActivas => categorias?.Where(c => c.Activa).ToArray();
    //Inicializo los datos:
    protected override async Task OnInitializedAsync()
    {
        categorias = await categoriaService.GetCategoriasAsync();
        configuracion = await configuracionservice.GetConfiguracionAsync();
        nombreEmpresaEditable = configuracion?.NombreEmpresa ?? string.Empty;
    }
    
    
    //llamo al dialogo
    private async Task OpenDialogAsync()
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await dialogService.ShowAsync<CrearCategoriaDialog>("Nueva categoria", options);
        
        var result = await dialog.Result;
        if (result?.Data is CategoriaResponseDto nuevo)
        {
            categorias = categorias?.Append(nuevo).ToArray();
        }
    }
    
    //acciones con las categorias
    private async Task ToggleEstadoAsync(CategoriaResponseDto categoria)
    {
        var dto = new ActualizarEstadoCategoriaDto() { Activa = !categoria.Activa }; //Invierto el estado
        var resultado = await categoriaService.UpdateEstadoCategoriaAsync(categoria.Id, dto);

        if (resultado.Exito)
        {
            categoria.Activa = !categoria.Activa;
        }
        else
        {
            snackbar.Add("No se pudo actualizar el estado", Severity.Error);
        }
    }

    //editar categoria
    private async Task EditCategoriaAsync(CategoriaResponseDto categoria)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        DialogParameters<CrearCategoriaDialog> parameters = new()
        {
            { x => x.categoriaExistente, categoria }
        };

        var dialog = await dialogService.ShowAsync<CrearCategoriaDialog>("Editar categoria", parameters, options);
        var result = await dialog.Result;
    }
    
    //toggle de estado de uso fecha vencimiento en tickets
    private async Task ToggleFechaVencimientoAsync(bool nuevo)
    {
        var dto = new ActualizarFechaVencimientoDto { UsarFechaVencimiento = nuevo };
        var resultado = await configuracionservice.UpdateFechaVencimientoAsync(dto);

        if (resultado.Exito)
        {
            configuracion.UsarFechaVencimiento = nuevo;
        }
        else
        {
            snackbar.Add("No se pudo actualizar la preferencia", Severity.Error);
        }
    }
    
    //Guardo el nombre de empresa
    private async Task GuardarNombreEmpresaAsync()
    {
        var dto = new ActualizarNombreEmpresaDto { NombreEmpresa = nombreEmpresaEditable };
        var resultado = await configuracionservice.UpdateNombreEmpresaAsync(dto);
        if (resultado.Exito)
        {
            configuracion!.NombreEmpresa = nombreEmpresaEditable;
            snackbar.Add("Nombre Actualizado", Severity.Success);
        }
        else
        {
            snackbar.Add(resultado.Error ?? "No se pudo actualizar el nombre", Severity.Error);
        }
    }
    
}
