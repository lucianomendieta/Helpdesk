@using Helpdesk.Web.Components;
@using Helpdesk.Web.Dtos;
@using Helpdesk.Web.Helpers
@using Helpdesk.Web.Models;
@using Helpdesk.Web.Services;
@using Microsoft.AspNetCore.Authorization;
@using Microsoft.AspNetCore.Components;
@using Microsoft.AspNetCore.Components.Authorization;

@inject ITicketService ticketService;
@inject IDialogService dialogService;
@inject ISnackbar snackbar;
@inject ITicketDetalleService ticketDetalle;
@inject IUsuarioService usuarioService;
@inject NavigationManager navigationManager;
@inject ICategoriaService CategoriaService;
@inject IConfiguracionService ConfiguracionService;

@attribute [Authorize]
@page "/tickets/{Id:int}"

@if (estadoResponse is null)
{
    <MudSkeleton/>
}
else if (estadoResponse == EstadoResponse.Prohibido)
{
    <AccesoDenegado/>
}
else if (estadoResponse == EstadoResponse.NoEncontrado)
{
    <MudAlert>El ticket no existe
        <MudLink Href="/tickets">← Volver a tickets</MudLink>
    </MudAlert>
}
else
{
    @*---------------------------------------------Cabecera-----------------------------------------------------*@
    <MudStack @onclick="@(() => navigationManager.NavigateTo("/tickets"))"
              AlignItems="AlignItems.Center"
              Row="true"
              Spacing="1"
              Style="color:var(--mud-palette-primary); font-weight:600; font-size:13px; cursor:pointer">
        <MudIcon Icon="@Icons.Material.Filled.ArrowBack" Style="font-size:17px"/>
        <MudText>Volver a tickets</MudText>
        
    </MudStack>
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
        <MudStack>
            <MudText Style="font-size:14px; color:#948C7D">Ticket #@Id</MudText>
            <MudText Typo="Typo.h4" Style="font-size:25px; font-weight:700; color:#221F1A">@ticket?.Titulo</MudText>
        </MudStack>
    </MudStack>
    
    @*------------------------------------COLUMNAS------------------------------------------------------*@
    <MudGrid>
        <MudItem xs="12" md="8">
            <MudPaper Style="padding: 22px; background:#fff; border:1px solid var(--borde-sutil); border-radius:16px;  margin-top: 15px;">
                <MudText Style="font-size:12.5px; font-weight:700; color:#948C7D; text-transform:uppercase; letter-spacing:.03em">
                    Descripción
                </MudText>
                <MudText Style="font-size:14px; color:#221F1A; line-height:1.55">
                    @ticket?.Descripcion
                </MudText>
            </MudPaper>
            
            @*-----------------------------------------Card de adjuntos-------------------------------------*@
            <MudPaper Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:22px;  margin-top: 15px;">
                <MudText Style="font-size:12.5px; font-weight:700; color:#948C7D; text-transform:uppercase; letter-spacing:.03em; margin-bottom: 15px">
                    Adjuntos
                </MudText>
                <GaleriaAdjuntos TicketId="Id" />
                <ListaDocumentos TicketId="Id" />
            </MudPaper>
            
            <MudPaper Style="background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; padding:22px;  margin-top: 15px;">

                @*-------------------------------------TITULO---------------------------------------------*@
                <MudText Style="font-size:12.5px; font-weight:700; color:#948C7D; text-transform:uppercase; letter-spacing:.03em; margin-bottom: 15px">
                    Actividad y comentarios
                </MudText>
                @if (ticketDetalles is null)
                {
                    <MudProgressLinear Indeterminate="true" />
                }
                else if (ticketDetalles.Length == 0)
                {
                    <MudText>Todavia no hay comentarios.</MudText>
                }
                else
                {
                    
                    
                    @*----------------------------------------TIMELINE-------------------------------------------*@
                    <MudStack Spacing="3">
                        @foreach (var detalle in ticketDetalles)
                        {
                            <div style="@($"border-radius:12px; padding:12px 14px; background:{(detalle.EsInterno ? "#FBF1D6" : "#F8F5EE")}")">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                        <MudText Style="font-size:13px; font-weight:700; color:#221F1A">@detalle.NombreAutor</MudText>
                                    </MudStack>
                                    <MudText Style="font-size:11px; color:#948C7D">@detalle.FechaCreacion.ToString("dd/MM/yyyy")</MudText>
                                </MudStack>
                                <MudText Style="font-size:13.5px; color:#221F1A; line-height:1.5; margin-top:5px">@detalle.Comentario</MudText>
                            </div>
                        }
                    </MudStack>
                }
                <MudForm @ref="form" @bind-IsValid="isvalid" >
                    <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:12px; padding:12px 14px; margin-top: 15px" >
                        <MudTextField @bind-Value="detalleDto.Comentario" 
                                      Lines="3" 
                                      Variant="Variant.Text" 
                                      Underline="false"
                                      Placeholder="Escribi un comentario..." Required="true"/>
                        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                            <AuthorizeView Roles="Agente,Analista,Administrador,Gerente">
                                <div @onclick="@(() => detalleDto.EsInterno = !detalleDto.EsInterno)"
                                     style="@($"display:flex; align-items:center; gap:8px; font-size:12.5px; " +
                                            $"font-weight:600; padding:6px 12px; border-radius:20px; cursor:pointer; " +
                                            $"background:{(detalleDto.EsInterno ? "#FBF1D6" : "#F0EDE4")}; " +
                                            $"color:{(detalleDto.EsInterno ? "#8A6D18" : "#756F63")}")">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Style="font-size: 16px" />
                                    <MudText>Nota interna (solo staff)</MudText>
                                </div>
                            </AuthorizeView>
                            <MudButton Variant="Variant.Filled" 
                                       Color="Color.Primary" 
                                       OnClick="AgregarComentarioAsync"
                                       Style="border-radius:10px; padding:9px 18px; font-weight:700; font-size:13px">Agregar comentario</MudButton>
                        </MudStack>
                    </div>
                </MudForm>
                
            
            </MudPaper>

            
        </MudItem>
        @*--------------------------------PROPIEDADES----------------------------------------------*@
        <MudItem xs="12" md="4">
            <MudPaper Style="padding: 22px; background:#fff; border:1px solid var(--borde-sutil); border-radius:16px; gap: 14px;">
                <MudStack Spacing="3">
                    <MudText Style="font-size:12.5px; font-weight:700; color:#948C7D; text-transform:uppercase; letter-spacing:.03em;">
                        Propiedades
                    </MudText>

                    @*ESTADO DEL TICKET*@
                    <MudText Style="font-size:11.5px; color:#948C7D">Estado</MudText>
                    <AuthorizeView Roles="Agente,Analista,Administrador,Gerente">
                        <Authorized>
                            <div style="@ticket!.Estado.ChipStyle(padding: "6px 12px", radius: "10px", fontSize: "13px")">
                                <MudSelect T="EstadoTicket" Variant="Variant.Text" Value="ticket!.Estado" 
                                           Underline="false" ValueChanged="ChangeEstadoAsync" Margin="Margin.Dense">
                                    @foreach (var estado in Enum.GetValues<EstadoTicket>())
                                    {
                                        <MudSelectItem T="EstadoTicket" Value="estado">@estado</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <MudChip T="string">@ticket?.Estado</MudChip>
                        </NotAuthorized>
                    </AuthorizeView>

                    @*PRIORIDAD*@
                    <MudText Style="font-size:11.5px; color:#948C7D">Prioridad</MudText>
                    <AuthorizeView Roles="Agente,Analista,Administrador,Gerente">
                        <Authorized>
                            <div style="@ticket!.Prioridad.ChipStyle(padding: "6px 12px", radius: "10px", fontSize: "13px")">
                                <MudSelect T="PrioridadTicket" Variant="Variant.Text" Margin="Margin.Dense" 
                                           Underline="false" Value="ticket!.Prioridad" ValueChanged="ChangePrioridadAsync">
                                    @foreach (var p in Enum.GetValues<PrioridadTicket>())
                                    {
                                        <MudSelectItem T="PrioridadTicket" Value="p">@p</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <MudStack Row="true">
                                <MudIcon Icon="@Icons.Material.Filled.Circle" Color="@ticket!.Prioridad.GetColor()"/>
                                <MudText>@ticket!.Prioridad</MudText>
                            </MudStack>
                        </NotAuthorized>
                    </AuthorizeView>

                    @*ASIGNACION DE AGENTES*@
                    <MudText Style="font-size:11.5px; color:#948C7D">Agente</MudText>
                    <AuthorizeView Roles="Administrador,Gerente">
                        <Authorized>
                            <div style="border:1.5px solid rgba(33,29,24,.1); border-radius:10px; display:flex; 
                            align-items:center; gap:8px; padding-left:10px">
                                <MudAvatar Size="Size.Small">
                                    @InicialHelper.InicialesHelper(AgenteActual?.NombrePila + " " + AgenteActual?.ApellidoPila)
                                </MudAvatar>
                                <MudSelect T="int?" Variant="Variant.Text" Margin="Margin.Dense" Underline="false"
                                           Value="ticket!.AgenteAsignadoId" ValueChanged="AsignarAgenteAsync">
                                    <MudSelectItem T="int?" Value="@((int?)null)">Sin asignar</MudSelectItem>
                                    @foreach (var agente in agentes ?? [])
                                    {
                                        <MudSelectItem T="int?" Value="@agente.Id">@agente.NombrePila @agente.ApellidoPila</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    @*SELECT DE CATEGORIAS*@
                    <MudText Style="font-size:11.5px; color:#948C7D">Categoria</MudText>
                    <AuthorizeView Roles="Agente,Analista,Administrador,Gerente">
                        <Authorized>
                            <div style="border:1.5px solid rgba(33,29,24,.1); border-radius:10px; padding-left:12px">
                                <MudSelect T="int?" Variant="Variant.Text" Margin="Margin.Dense" 
                                           Underline="false" Value="ticket!.CategoriaId" ValueChanged="ChangeCategoriaAsync">
                                    @if (categorias is not null)
                                    {
                                        @foreach (var c in categorias)
                                        {
                                            <MudSelectItem T="int?" Value="c.Id">@c.Nombre</MudSelectItem>
                                        }
                                    }
                                </MudSelect>
                            </div>
                        </Authorized>
                    </AuthorizeView>

                    @*Nombre del cliente*@
                    <MudText Style="font-size:11.5px; color:#948C7D">Cliente</MudText>
                    <MudText Style="font-size:13.5px; color:#221F1A; font-weight:500">@ticket?.NombreCreador</MudText>

                    @*Fecha de vencimiento (si tiene)*@
                    @if (configuracion?.UsarFechaVencimiento == true)
                    {
                        <MudText Style="font-size:11.5px; color:#948C7D">Fecha de vencimiento</MudText>
                        <AuthorizeView Roles="Agente,Analista,Administrador,Gerente">
                            <Authorized>
                                <div style="border:1.5px solid rgba(33,29,24,.1); border-radius:10px;padding-left:12px">
                                    <MudDatePicker Date="@(ticket?.FechaVencimiento?.DateTime)"
                                                   DateChanged="ChangeVencimientoAsync"
                                                   Clearable="true"
                                                   Underline="false"
                                                   Variant="Variant.Text"
                                                   Margin="Margin.Dense" />
                                </div>
                            </Authorized>
                            <NotAuthorized>
                                <MudText Style="font-size:13.5px; color:#221F1A; font-weight:500">@(ticket?.FechaVencimiento?.ToString("dd/MM/yyyy") ?? "Sin fecha asignada")</MudText>
                            </NotAuthorized>
                        </AuthorizeView>
                    }

                    @*Creado en fecha:*@
                    <MudText Style="font-size:11.5px; color:#948C7D">Fecha de creacion</MudText>
                    <MudText Style="font-size:13.5px; color:#221F1A; font-weight:500">@ticket?.FechaCreacion.ToString("dd/MM/yyyy")</MudText>
                </MudStack>
                

            </MudPaper>
        </MudItem>
    </MudGrid>
}


@code {
    private bool isvalid;
    private MudForm form;

    //Parametros
    [Parameter] 
    public int Id { get; set; }

    [CascadingParameter]
    public Task<AuthenticationState>? authstateTask { get; set; }
    
    //Dtos
    private TicketDto? ticket;
    private TicketDetalleResponseDto[]? ticketDetalles;
    private UsuarioDto[]? agentes;
    private CrearTicketDetalleDto detalleDto = new ();
    private CategoriaResponseDto[]? categorias;
    
    //Estados
    private EstadoResponse? estadoResponse;

    //configuracion
    private ConfiguracionResponseDto? configuracion;
    
    //Campo calculado
    private UsuarioDto? AgenteActual => agentes?.FirstOrDefault(a => a.Id == ticket?.AgenteAsignadoId);

    protected override async Task OnInitializedAsync()
    {
        var resultado = await ticketService.GetTicketAsync(Id);
        estadoResponse = resultado.Estado;
        ticket = resultado.Ticket;
        configuracion = await ConfiguracionService.GetConfiguracionAsync();
        

        if (estadoResponse == EstadoResponse.Ok)
        {
            ticketDetalles = await ticketDetalle.GetDetallesAsync(Id);
            var authState = await authstateTask!;
            var user = authState.User;
            if (user.IsInRole("Administrador") || user.IsInRole("Gerente"))
            {
                agentes = await usuarioService.GetUsuariosAsignablesAsync();
                categorias = await CategoriaService.GetCategoriasActivasAsync();
            }
        }
    }  

    private async Task AgregarComentarioAsync()
    {
        await form.ValidateAsync();
        if (isvalid)
        {
            //Espero el resultado del post
            var resultado = await ticketDetalle.CreateDetalleAsync(Id, detalleDto);

            //Si fue exitoso, se mete al array y limpio el dto
            if (resultado.Exito && resultado.Data is not null)
            {
                ticketDetalles = ticketDetalles?.Append(resultado.Data).ToArray();
                detalleDto = new();
                await form.ResetAsync();
            }
            else
            {
                snackbar.Add(resultado.Error ?? "No se pudo agregar el comentario", Severity.Error);
            }
        }
    }

    private async Task ChangeEstadoAsync(EstadoTicket nuevo)
    {
        var dto = new PutTicketStateDto
            {
                EstadoTicket = nuevo
            };
        var hasUpdated = await ticketService.ChangeTicketStateAsync(Id, dto);
        if (hasUpdated)
        {
            ticket!.Estado = nuevo;
        }
        else
        {
            snackbar.Add("No se pudo editar el estado del ticket", Severity.Error);
        }
    }

    private async Task ChangePrioridadAsync(PrioridadTicket nuevo)
    {
        var dto = new ActualizarPrioridadTicketDto
            {
                Prioridad = nuevo
            };
        var hasUpdated = await ticketService.ChangeTicketPriorityAsync(Id, dto);
        if (hasUpdated)
        {
            ticket!.Prioridad = nuevo;
        }
        else
        {
            snackbar.Add("No se pudo editar la prioridad del ticket", Severity.Error);
        }
    }

    private async Task AsignarAgenteAsync(int? nuevoAgenteId)
    {
        var id = ticket!.Id;
        var dto = new AsignarTicketDto { AgenteId = nuevoAgenteId };
        ResultadoApi assigned = await ticketService.AssignTicketAsync(id, dto);
        if (!assigned.Exito)
        {
            snackbar.Add(assigned.Error ?? "Se ha producido un error, intente de nuevo", Severity.Error);
        }
        else
        {
            var agenteElegido = agentes?.FirstOrDefault(a => a.Id == dto.AgenteId);
            ticket.AgenteAsignadoId = dto.AgenteId;
            ticket.NombreAgente = agenteElegido == null ? null : agenteElegido.NombrePila + " " + agenteElegido.ApellidoPila;
            snackbar.Add("Usuario Asignado!", Severity.Info);
        }
    }

    //cambio la categoria del ticket
    private async Task ChangeCategoriaAsync(int? nuevo)
    {
        var dto = new ActualizarCategoriaTicketDto()
        {
            categoriaId = nuevo!.Value
        };
        var hasUpdated = await ticketService.ChangeTicketCategoriaAsync(Id, dto);
        if (hasUpdated)
        {
            ticket!.CategoriaId = nuevo;
        }
        else
        {
            snackbar.Add("No se pudo editar la categoria del ticket", Severity.Error);
        }

    }
    
    //cambio la fecha de vencimiento del ticket
    private async Task ChangeVencimientoAsync(DateTime? fechaNueva)
    {
        //Instancio el dto para tenerlo dispo
        ActualizarVencimientoTicketDto dto = new();
        //Si es null no tiene vencimiento, si si tiene cargada la fecha convierto a date time
        if (fechaNueva is null)
        {
            dto.FechaVencimiento = null;
        }
        else
        {
            dto.FechaVencimiento = new DateTimeOffset(fechaNueva.Value, TimeZoneInfo.Local.GetUtcOffset(fechaNueva.Value));
        }
        var isUpdated = await ticketService.ChangeTicketVencimientoAsync(Id, dto);
        if (isUpdated)
        {
            ticket!.FechaVencimiento = dto.FechaVencimiento;
        }
        else
        {
            snackbar.Add("No se pudo actualizar la fecha de vencimiento, favor verificar", Severity.Error);
        }
        
    }
}
