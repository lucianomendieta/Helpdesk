@using Helpdesk.Web.Dtos;
@using Helpdesk.Web.Services;
@using Helpdesk.Web.Models;
@inject IUsuarioService usuarioService
@inject MudBlazor.ISnackbar snackbar


<MudDialog>
    <TitleContent>
        <MudText Style="font-size: 18px; font-weight: 700; color: #221F1A;">Nuevo Usuario</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="IsValid">
            <div style="display: flex; gap: 14px;">
                @*----------------------------NOMBRE Y APELLIDO-------------------------------------*@
                <div style="flex:1; min-width: 0">
                    <MudStack>
                        <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A">Nombre de pila</MudText>
                        <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px; margin-bottom:16px">
                            <MudTextField T="string" 
                                          Underline="false" 
                                          @bind-Value="dto.NombrePila" 
                                          Required="true" 
                                          RequiredError="Ingrese el nombre real del usuario"
                                          Style="font-size:13.5px; color:#221F1A"/>
                        </div>
                    </MudStack>
                </div> 
                
                <div style="flex: 1; min-width: 0">
                    <MudStack>
                        <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A;">Apellido</MudText>
                        <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px; margin-bottom:16px">
                            <MudTextField T="string" 
                                          Underline="false" 
                                          @bind-Value="dto.ApellidoPila" 
                                          Required="true" 
                                          RequiredError="Ingrese el apellido del usuario"
                                          Style="font-size:13.5px; color:#221F1A"/>
                        </div>
                    </MudStack>
                </div>
                
                
            </div>
            
            <MudStack>
                <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A;">Email</MudText>
                <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px; margin-bottom:16px">
                    <MudTextField T="string" 
                                  @bind-Value="dto.Email" 
                                  Required="true" 
                                  Underline="false"
                                  Margin="Margin.Dense"
                                  RequiredError="Ingrese el Email del usuario"
                                  InputType="InputType.Email"
                                  Style="font-size:13.5px; color:#221F1A"/>
                </div>
                
            </MudStack>
            
            <MudStack>
                <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A">Nombre de usuario</MudText>
                <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px">
                    <MudTextField T="string" 
                                  @bind-Value="dto.Nombre" 
                                  Required="true" 
                                  Underline="false"
                                  Margin="Margin.Dense"
                                  RequiredError="Ingrese el nombre de usuario"
                                  Style="font-size:13.5px; color:#221F1A"/>
                </div>
                
                <MudText Style="font-size: 10px; color: #948C7D; margin-bottom: 6px">Se usa para iniciar sesion</MudText>
            </MudStack>
            
            <MudStack>
                <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A">Contraseña</MudText>
                <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px; margin-bottom:16px">
                    <MudTextField T="string" 
                                  @bind-Value="dto.Password" 
                                  Required="true" 
                                  RequiredError="Ingrese una contraseña"
                                  InputType="@(mostrarPassword ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(mostrarPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="togglemostrarPassword"
                                  Underline="false"
                                  Margin="Margin.Dense"
                                  Style="font-size:13.5px; color:#221F1A"/>
                </div>
                
            </MudStack>
            
            <MudText Style="font-size:12.5px; font-weight:600; color:#221F1A; margin-bottom:6px">Rol</MudText>
            <div style="display:flex; gap:8px; margin-bottom:16px; flex-wrap:wrap">
                @foreach (var rol in Enum.GetValues<RolUsuario>())
                {
                    var seleccionado = dto.Rol == rol;
                    <div @onclick="() => dto.Rol = rol"
                         style="@($"border-radius:20px; padding:6px 14px; font-size:12.5px; cursor:pointer; " +
                                $"border:1.5px solid {(seleccionado ? "var(--mud-palette-primary)" : "rgba(33,29,24,.12)")}; " +
                                $"background:{(seleccionado ? "var(--mud-palette-primary)" : "transparent")}; " +
                                $"color:{(seleccionado ? "#fff" : "#756F63")}; " +
                                $"font-weight:{(seleccionado ? 600 : 500)}")">
                        @rol
                    </div>
                }
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel"
                   Style="font-size:13.5px; font-weight:600; color:#756F63; text-transform:none">
            Cancelar
        </MudButton>
        <MudButton OnClick="Submit" 
                   Color="Color.Primary" 
                   Disabled="!IsValid"
                   Style="border-radius:11px; padding:11px 22px; font-size:13.5px; font-weight:700; text-transform:none">
            Crear
        </MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm form;
    private bool IsValid;
    private CrearUsuarioDto dto = new();

    private bool mostrarPassword;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        //Espero a que se valide el formuladio
        await form.ValidateAsync();
        if (IsValid)
        {
            var result = await usuarioService.CreateUsuarioAsync(dto);
            if (!result.Exito)
            {
                snackbar.Add(result.Error ?? "No se pudo crear el usuario, verifique los campos", Severity.Warning);
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(result.Data));
                snackbar.Add("Se ha creado correctamente el usuario", Severity.Info);
            }
        }
    }

    private void togglemostrarPassword() => mostrarPassword = !mostrarPassword;
}
