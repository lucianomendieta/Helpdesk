@using Helpdesk.Web.Models;
@inject IAdjuntoService adjuntoService;
@inject AdjuntoInterop adjuntoInterop;
@inject ISnackbar snackbar;
@inject IDialogService dialogService;

@implements IAsyncDisposable 


@if (error)
{
    <MudAlert Severity="Severity.Error">No se pudieron cargar las imagenes</MudAlert>
}
else if (adjuntos is null)
{
    <MudProgressLinear Indeterminate="true"/>
}
else
{
    <MudStack Row="true" Wrap="Wrap.Wrap" Style="gap: 10px;margin-bottom: 15px">
        <MudFileUpload T="IBrowserFile"
                       FilesChanged="UploadAsync"
                       Accept=".jpg,.jpeg,.png,.webp"
                       MaxFileSize="@(5 * 1024 * 1024)"
                       @ref="fileUpload"> 
            
            <CustomContent>
                <MudPaper
                    Style="background:repeating-linear-gradient(135deg,#EDE9DF,#EDE9DF 8px,#E4DFD2 8px,#E4DFD2 16px); 
                    border:1px solid rgba(33,29,24,.08); border-radius:12px; cursor: pointer; width:100px; height:100px; padding: 5px" 
                    @onclick="@(() => context.OpenFilePickerAsync())"
                    Class="d-flex flex-column align-content-center justify-content-center"
                    >
                    <MudIcon Icon="@Icons.Material.Filled.Image" Style="font-size:20px; color:#948C7D" Size="Size.Small" />
                    <MudText Style="font-size: 15px; color: #948C7D">Adjuntar imagen</MudText>
                </MudPaper>
            </CustomContent>
                   
        </MudFileUpload>

        @if (adjuntos.Length == 0)
        {
        <MudText>Aqui no hay adjuntos, ingresa una evidencia para tu ticket!</MudText>
        }
        

        @foreach (var adjunto in adjuntos)
        {
            @if (urls.TryGetValue(adjunto.Id, out var url))
            {
                <MudImage Src="@url" 
                    Alt="@adjunto.NombreOriginal" 
                    Height="100" 
                    Width="100"
                    ObjectFit="ObjectFit.Cover" 
                    Class="rounded" 
                    @onclick="@(() => AbrirPreviaAsync(url, adjunto))"
                    Style="cursor: pointer; border-radius:12px; border:1px solid var(--borde-sutil)"/>
            }
        }
    </MudStack>
}


@code {
    [Parameter] public int TicketId { get; set; }
    private AdjuntoResponseDto[]? adjuntos;
    private bool error;
    private readonly Dictionary<int, string> urls = new();
    private MudFileUpload<IBrowserFile> fileUpload = default!;


    protected override async Task OnInitializedAsync()
    {
        //Listo los adjuntos, si es null tiro error
        adjuntos = await adjuntoService.ListarAdjuntosAsync(TicketId);
        if (adjuntos is null)
        { 
            error = true;
            return;
        }
        //Filtro que sean imagenes
        adjuntos = adjuntos.Where(a => a.Tipo == TipoAdjunto.Imagen).ToArray();
        //Para cada adjunto muestro su contenido y creo la url
        foreach (var adjunto in adjuntos)
        {
            await CargarUrlAsync(adjunto);
        }
    }

    public async ValueTask DisposeAsync()
    {
        foreach ( var url in urls.Values)
        {
            await adjuntoInterop.RevokeUrl(url);
        }
        urls.Clear();
    }

    private async Task AbrirPreviaAsync(string url, AdjuntoResponseDto adjunto)
    {
        //Paso los parametros al modal
        DialogParameters<VistaPreviaDialog> parameters = new()
        {
            {x => x.Url, url},
            { x => x.NombreArchivo, adjunto.NombreOriginal },
            { x => x.Tipo, adjunto.Tipo}
        };
        //Le paso las opciones
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };

        var dialog = await dialogService.ShowAsync<VistaPreviaDialog>("Vista previa de imagen", parameters, options);

        var resultado = await dialog.Result;
        if (resultado?.Data is true)
        {
            var eliminado = await adjuntoService.BorrarAdjuntoAsync(TicketId, adjunto.Id);
            if (eliminado)
            {
                await adjuntoInterop.RevokeUrl(url);
                urls.Remove(adjunto.Id);
                adjuntos = adjuntos!.Where(a => a.Id != adjunto.Id).ToArray();
            }
            else
            {
                snackbar.Add("No se pudo eliminar la imagen, verifica tus permisos", Severity.Error);
            }
        }
    }

    //Upload desde la galeria
    private async Task UploadAsync(IBrowserFile archivo)
    {
        if (archivo is null) { return;}
        var creado = await adjuntoService.SubirAdjuntoAsync(TicketId, archivo);
        await fileUpload.ClearAsync();
        if (creado is null)
        {
            snackbar.Add("No se pudo subir el archivo, verifique", Severity.Error);
            return;
        }
        if (adjuntos is null) return;
        adjuntos = adjuntos.Append(creado).ToArray();
        await CargarUrlAsync(creado);
        
    }

    //Metodo para generar las urls en base al adjunto
    private async Task CargarUrlAsync(AdjuntoResponseDto adjunto)
    {
        var stream = await adjuntoService.MostrarAdjuntoAsync(TicketId, adjunto.Id);
        if (stream is not null)
        {
            var url = await adjuntoInterop.CreateUrl(stream, adjunto.ContentType);
            urls[adjunto.Id] = url;
        }
    }
}
