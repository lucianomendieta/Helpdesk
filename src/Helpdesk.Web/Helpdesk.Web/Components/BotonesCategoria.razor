<div style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px">
    @if (Categorias is null)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (!Categorias.Any())
    {
        <MudText Typo="Typo.body1" Color="Color.Error">No hay categorias disponibles. Contacta al administrador.</MudText>
    }
    else
    {
        @foreach (var categoria in Categorias)
        {
            <div class="categoria-card" 
                @onclick="() => OnSeleccionar.InvokeAsync(categoria)"
                 style="border-radius:14px; padding:18px 16px; 
                 display:flex; flex-direction:column; gap:8px; cursor:pointer">
                @*-------------------Icono---------------------------*@
                <div style="width:38px; height:38px; border-radius:10px; 
                        background:var(--accent-soft); display:flex; align-items:center; justify-content:center">
                    <MudIcon Icon="@CategoriaIconHelper.ObtenerCategoria2Icon(categoria.Icono)" Style="font-size:21px; color:var(--mud-palette-primary)"/>
                </div>
                @*----------------------------------Nombre de la CAtegoria------------------------------------*@
                <MudText Style="font-size:14px; font-weight:600; color:#221F1A; line-height:1.25">@categoria.Nombre</MudText>

            </div>
        }
    }
</div>

@code {
    [Parameter] public CategoriaResponseDto[]? Categorias { get; set; }
    [Parameter] public EventCallback<CategoriaResponseDto> OnSeleccionar { get; set; }
}