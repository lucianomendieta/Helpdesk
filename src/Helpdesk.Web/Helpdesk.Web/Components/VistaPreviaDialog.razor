@inject IDialogService dialogService;

<MudDialog>
    <DialogContent>
        @if (Tipo == TipoAdjunto.Imagen)
        {
            <MudImage Src="@Url" Alt="@NombreArchivo" Fluid="true" />
        }
        else
        {
            <iframe src="@Url" style="width: 100%; height: 70vh; border:none;" />
        }
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="EliminarAsync">Eliminar</MudButton>
        <MudButton Href="@Url" StartIcon="@Icons.Material.Filled.Download" download="@NombreArchivo">Descargar</MudButton>
        <MudButton StartIcon="@Icons.Material.Filled.Close" OnClick="@( () => mudDialog.Close())">Cerrar</MudButton>
    </DialogActions>
</MudDialog>


@code {
    [CascadingParameter] private IMudDialogInstance mudDialog { get; set; } = default!;

    [Parameter] public string Url { get; set; } = string.Empty;
    [Parameter] public string NombreArchivo { get; set; } = string.Empty;
    [Parameter] public TipoAdjunto Tipo { get; set; }

    private async Task EliminarAsync()
    {
        var confirmado = await dialogService.ShowMessageBoxAsync(
            title: "Eliminar?",
            message: $"Eliminaras {NombreArchivo}, esta accion no se puede deshacer",
            yesText: "Borrar",
            noText: "Cancelar");

        if (confirmado != true) { return; }
        mudDialog.Close(DialogResult.Ok(true));
    }
}
