@using Helpdesk.Web.Models;
@inject IAdjuntoService adjuntoService;
@inject AdjuntoInterop adjuntoInterop;
@inject ISnackbar snackbar;
@inject IDialogService dialogService;


@if (error)
{
    <MudAlert Severity="Severity.Error">No se cargo ningun documento</MudAlert>
}
else if (documentos is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack>
        @*Meto el placeholder para cargar archivos*@
        @if (PuedeSubir)
        {
            @if (documentos.Length < MaxDocs)
            {
                <MudFileUpload T="IBrowserFile"
                            FilesChanged="UploadAsync"
                            Accept=".pdf"
                            MaxFileSize="@(10*1024*1024)"
                            @ref="fileUpload">
                                <CustomContent>
                        <MudPaper Outlined="true"
                            Style="border-style: dashed; cursor: pointer; width:100px; height:100px; padding: 5px"
                            @onclick="@(() => context.OpenFilePickerAsync())"
                            Class="d-flex flex-column align-content-center justify-content-center">
                                        <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" Style="color:#C1571F; font-size:20px" />
                                        <MudText Style="font-size:15px; color:#948C7D">Adjuntar PDF</MudText>
                                    </MudPaper>
                                </CustomContent>
                        </MudFileUpload>
            }
            else
            {
                <MudAlert Severity="Severity.Info">Alcanzaste el maximo de @MaxDocs documentos por ticket</MudAlert>
            }
        }
        @*
        @if (documentos.Length == 0)
        {
            <MudText> Aun no hay adjuntos, puedes cargar uno aca mismo!</MudText>
        }
        *@
        @foreach (var doc in documentos)
        {
            <div style="padding:10px 0; border-top:1px solid rgba(33,29,24,.06)">
                <MudStack Row="true" AlignItems="AlignItems.Center">
                    <MudIcon Icon="@Icons.Material.Filled.PictureAsPdf" />
                    <MudStack Spacing="0" Style="flex: 1;">
                        <MudText Style="font-size:13px; font-weight:500; color:#221F1A;">@doc.NombreOriginal</MudText>
                        <MudText Style="font-size:11px; color:#948C7D">@FormatearTamanio(doc.TamanioBytes)</MudText>
                    </MudStack>
                    

                    <MudSpacer />

                    <div style="font-size:12px; font-weight:600; color:var(--mud-palette-primary); padding:7px 12px; 
                    border:1px solid rgba(33,29,24,.1); border-radius:9px; cursor:pointer"
                         @onclick="@(() => VerAsync(doc))">
                        Ver
                    </div>
                </MudStack>
            </div>
                
           
        }
    </MudStack>
}



@code {
    [Parameter] public int TicketId { get; set; }
    [Parameter] public bool PuedeSubir { get; set; }
    private AdjuntoResponseDto[]? documentos;
    private bool error;
    private MudFileUpload<IBrowserFile> fileUpload = default!;
    private const int MaxDocs = 2;

    //Inicializo los documentos al llegar al form
    protected override async Task OnInitializedAsync()
    {
        documentos = await adjuntoService.ListarAdjuntosAsync(TicketId);
        if (documentos is null)
        {
            error = true;
            return;
        }

        //Filtro para que sean documentos
        documentos = documentos.Where(d => d.Tipo == TipoAdjunto.Documento).ToArray();
    }


    //Subir los archivos
    private async Task UploadAsync(IBrowserFile archivo)
    {
        if (archivo is null) { return; }
        var creado = await adjuntoService.SubirAdjuntoAsync(TicketId, archivo);
        await fileUpload.ClearAsync();
        if (creado is null)
        {
            snackbar.Add("No se pudo subir el archivo, verifique", Severity.Error);
            return;
        }
        if (documentos is null) return;
        documentos = documentos.Append(creado).ToArray();
    }

    //Formatear el tamaño dentro de la vista
    private static string FormatearTamanio(long bytes)
    {
        if (bytes < (1 * 1024 * 1024))
        {
            var kbs = bytes / 1024d;
            return $"{kbs:F0}KB";
        }
        else
        {
            var mbs = bytes / (1024d * 1024d);
            return $"{mbs:F1}MB";
        }
    }

    //Para vista previa de pdfs
    private async Task VerAsync(AdjuntoResponseDto doc)
    {
        //obtengo el stream
        var stream = await adjuntoService.MostrarAdjuntoAsync(TicketId, doc.Id);
        if (stream is null)
        {
            snackbar.Add("No se pudo cargar el archivo", Severity.Error);
            return;
        }

        //creo la url
        var url = await adjuntoInterop.CreateUrl(stream, doc.ContentType);

        //Le paso los parametros al modal
        DialogParameters<VistaPreviaDialog> parameters = new()
        {
            { x => x.Url, url},
            { x => x.NombreArchivo, doc.NombreOriginal},
            { x => x.Tipo, doc.Tipo}
        };

        //armo los parametros para el dialog
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth=true};
        var dialog = await dialogService.ShowAsync<VistaPreviaDialog>("Vista previa del documento", parameters, options);

        var resultado = await dialog.Result;

        //Si el usuario pidio borrar
        if (resultado?.Data is true)
        {
            var eliminado = await adjuntoService.BorrarAdjuntoAsync(TicketId, doc.Id);
            if (eliminado)
            {
                documentos = documentos!.Where(d => d.Id != doc.Id).ToArray();
            }
            else
            {
                snackbar.Add("No se pudo eliminar, verifica tus permisos.", Severity.Error);
            }
        }

        await adjuntoInterop.RevokeUrl(url);
    }
}
