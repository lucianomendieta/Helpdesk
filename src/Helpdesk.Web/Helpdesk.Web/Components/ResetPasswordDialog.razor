@using Helpdesk.Web.Dtos;
@using Helpdesk.Web.Services;
@inject IUsuarioService usuarioService;
@inject MudBlazor.ISnackbar snackbar;


<MudDialog>
    <TitleContent>
        <MudText Style="font-size:18px; font-weight:700; color:#221F1A;">Reiniciar contraseña</MudText>
    </TitleContent>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="IsValid">
            <MudText Style="font-size:13.5px; color:#756F63; line-height:1.55; margin-bottom:18px">
                Ingresá la nueva contraseña para <b style="color:#221F1A">@usuario.Nombre</b>. El usuario deberá cambiarla al iniciar sesión.
            </MudText>
            
            <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A">Nueva contraseña</MudText>
            <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px; margin-bottom:16px">
                <MudTextField T="string" 
                              @bind-Value="dto.NewPassword" 
                              Required="true" 
                              RequiredError="Ingrese la nueva contraseña del usuario" 
                              InputType="@(mostrarPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(mostrarPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="togglemostrarPassword"
                              Underline="false"
                              Margin="Margin.Dense"/>
            </div>
            
            
            <MudText Style="font-size: 12.5px; font-weight: 600; color: #221F1A">Confirmar contraseña</MudText>
            <div style="border:1.5px solid rgba(33,29,24,.12); border-radius:11px; padding:5px 14px; margin-bottom:16px">
                <MudTextField T="string" 
                              @bind-Value="confirmPassword" 
                              Required="true" 
                              RequiredError="Confirme la contraseña" 
                              InputType="@(mostrarPassword ? InputType.Text : InputType.Password)"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(mostrarPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="togglemostrarPassword"
                              Underline="false"
                              Margin="Margin.Dense"
                              Validation="@(new Func<string, string>(x => x == dto.NewPassword ? null : "Las contraseñas no coinciden"))" />
            </div>
            
            
            <div style="display:flex; gap:10px; align-items:flex-start; background:#FBF3E4; border:1px solid rgba(217,155,45,.25); border-radius:11px; padding:12px 14px; margin-bottom:26px">
                <MudIcon Icon="@Icons.Material.Filled.Warning" Style="font-size:18px; color:#B8792B"/>
                <MudText Style="font-size:12.5px; color:#8A5F1F; font-weight:500; line-height:1.5">
                    Las contraseñas deben coincidir. Esta acción no se puede deshacer.
                </MudText>
            </div>
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel" Style="font-size:13.5px; font-weight:600; color:#756F63; text-transform:none">Cancelar</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Style="border-radius:11px; padding:11px 22px; font-size:13.5px; font-weight:700; text-transform:none">Reiniciar Contraseña</MudButton>
    </DialogActions>
</MudDialog>
@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public UsuarioDto usuario { get; set; } = new();

    private MudForm form;
    private bool IsValid;
    private ResetPasswordDto dto = new();
    private string? confirmPassword;

    private bool mostrarPassword;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (IsValid)
        {
            var id = usuario.Id;
            ResultadoApi reseted = await usuarioService.ResetPasswordUsuarioAsync(id, dto);
            if (!reseted.Exito)
            {
                snackbar.Add(reseted.Error ?? "Se ha producido un error, intente de nuevo", Severity.Error);
            }
            else
            {
                MudDialog.Close(DialogResult.Ok(true));
                snackbar.Add("Contraseña reiniciada!", Severity.Info);
            }
        }
    }
    
    private void togglemostrarPassword() => mostrarPassword = !mostrarPassword;

}
