@using Helpdesk.Web.Theme
@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase

@inject ILocalStorageService storage;
@inject NavigationManager navigation;
@inject IAuthService auth;

<MudThemeProvider @ref="themeProvider" @bind-IsDarkMode="isDarkMode" Theme="HelpdeskTheme.Default"/>
<MudPopoverProvider/>
<MudDialogProvider/>
<MudSnackbarProvider/>

<MudLayout>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="drawerOpen" Variant="DrawerVariant.Mini">
                @*Logo de header*@
                <MudStack Row="true" AlignItems="AlignItems.Center"
                          Justify="@(drawerOpen ? Justify.FlexStart : Justify.Center)"
                          Class="gap-2">
                    <div style="border-radius: 9px; 
                                background-color: var(--mud-palette-primary); 
                                width:40px; 
                                height:40px; 
                                display:flex; 
                                align-items:center; 
                                justify-content:center;">
                        <MudIcon Icon="@Icons.Material.Filled.SupportAgent" Color="Color.Inherit" />
                    </div>
                    @if (drawerOpen)
                    {
                        <MudText Typo="Typo.h6">MesaPlus</MudText>
                    }
                </MudStack>
                
                @*instancio el drawer*@
                <MudIconButton Icon="@Icons.Material.Filled.Menu" OnClick="ToggleDrawer" Style="align-self: flex-start; color: var(--mud-palette-primary)"/>

                @*Vista del nav para el cliente*@
                <AuthorizeView Roles="Cliente">
                    <Authorized Context="vistaCliente">
                        <MudNavMenu>
                            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Inicio</MudNavLink>
                            <MudNavLink Href="/tickets" Icon="@Icons.Material.Filled.Assignment">Mis Tickets</MudNavLink>
                            <MudNavLink Href="/mi-perfil" Icon="@Icons.Material.Filled.Person">Mi Perfil</MudNavLink>
                        </MudNavMenu>
                    </Authorized>
                </AuthorizeView>

                @*Vista del nav para el personal*@
                <AuthorizeView Roles="Agente,Analista">
                    <Authorized Context="vistaAgenteAnalista">
                        <MudNavMenu>
                            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Inicio</MudNavLink>
                            <MudNavLink Href="/tickets/mios"  Icon="@Icons.Material.Filled.AssignmentInd">Tickets Asignados</MudNavLink>
                            <MudNavLink Href="/tickets" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Assignment">Todos los Tickets</MudNavLink>
                            <MudNavLink Href="/mi-perfil" Icon="@Icons.Material.Filled.Person">Mi Perfil</MudNavLink>
                        </MudNavMenu>
                    </Authorized>
                </AuthorizeView>

                @*Vista del nav para administradores*@
                <AuthorizeView Roles="Administrador,Gerente">
                    <Authorized Context="vistaAdmins">
                        <MudNavMenu>
                            <MudNavLink Href="/" Icon="@Icons.Material.Filled.Home" Match="NavLinkMatch.All">Inicio</MudNavLink>
                            <MudNavLink Href="/tickets" Icon="@Icons.Material.Filled.Assignment">Tickets</MudNavLink>
                            <MudNavLink Href="/usuarios" Icon="@Icons.Material.Filled.People">Usuarios</MudNavLink>
                            <MudNavLink Href="/reportes" Icon="@Icons.Material.Filled.BarChart">Reportes</MudNavLink>
                            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">Configuracion</MudNavLink>
                            <MudNavLink Href="/mi-perfil" Icon="@Icons.Material.Filled.Person">Mi Perfil</MudNavLink>
                        </MudNavMenu>
                    </Authorized>
                </AuthorizeView>


                @*Card de usuario*@
                <MudStack Style="margin-top:auto; width:100%; overflow-x:hidden">

                    @*Declaro las variables para el usuario*@
                    @{
                        var nombre = context.User.Identity?.Name;
                        var rol = context.User.FindFirst("role")?.Value;
                    }
                    
                    <div style="height:1px; background:rgba(255,255,255,.06); margin-bottom:12px"/>

                    @if (drawerOpen)
                    {
                        <MudPaper Elevation="0" Style="background:#F3EEE4; 
                                                        border-radius:13px; 
                                                        padding:14px 14px 12px; 
                                                        display:flex; 
                                                        flex-direction:column; 
                                                        gap:10px">
                            @*toggle de modo oscuro*@
                            <MudStack Row="true" Style="justify-content: space-between; align-items: center; width: 100%;">
                                <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-primary); font-size: 12.5px; font-weight: 600;">
                                    Modo oscuro
                                </MudText>
                                <MudSwitch T="bool"
                                           @bind-Value="isDarkMode"
                                           @bind-Value:after="GuardarModo"
                                           Color="Color.Primary"
                                           ThumbIcon="@(isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.LightMode)"
                                           Style="margin: 0;"/>
                            </MudStack>
                            
                            
                            @*dibujo el avatar con el helper*@
                            <MudStack Row="true" Style="gap: 2px; justify-content: space-between;">
                                <MudAvatar Style="width:30px;
                                                    height:30px;
                                                    font-size:12px;
                                                    font-weight:700;
                                                    background:#E7E1D4;
                                                    color:#756F63;
                                                    cursor:pointer"
                                           @onclick="@(() => navigation.NavigateTo("/mi-perfil"))">
                                    @InicialHelper.InicialesHelper(nombre)
                                </MudAvatar>

                                @*datos del usuario*@
                                <MudStack >
                                    <MudText Typo="Typo.body1" Style="color: var(--mud-palette-text-primary); font-size: 12.5px; font-weight: 600;">
                                        @nombre
                                    </MudText>
                                    <MudText Typo="Typo.subtitle2"
                                             Style="color: var(--mud-palette-primary); font-size: 11px; font-weight: 600;">
                                        @rol
                                    </MudText>
                                </MudStack>

                                @*Boton de logout*@
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Logout" 
                                    Style="margin-left:auto; color: #948C7D" 
                                    OnClick="CerrarSesion"
                                    Size="Size.Small"/>
                            </MudStack>
                        </MudPaper>
                    }
                    else
                    {
                        <MudPaper Elevation="0" Style="background:#F3EEE4; 
                                                        border-radius:13px; 
                                                        padding:14px 14px 12px; 
                                                        display:flex; 
                                                        flex-direction:column; 
                                                        gap:10px">
                            <MudStack AlignItems="AlignItems.Center" Style="gap: 2px;">
                                @*toggle de modo oscuro*@
                                <MudIconButton Icon="@(isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                               OnClick="ToggleDarkMode"
                                               Size="Size.Small" />
                                
                                @*Avatar*@
                                <MudAvatar Style="width:30px; 
                                                            height:30px; 
                                                            font-size:12px; 
                                                            font-weight:700; 
                                                            background:#E7E1D4; 
                                                            color:#756F63;
                                                            cursor:pointer;"
                                           @onclick="@(() => navigation.NavigateTo("/mi-perfil"))">
                                    @InicialHelper.InicialesHelper(nombre)
                                </MudAvatar>
                                
                                    
                                @*Boton de logout*@
                                <MudIconButton 
                                    Icon="@Icons.Material.Filled.Logout" 
                                    Style="color: #948C7D" 
                                    OnClick="CerrarSesion"
                                    Size="Size.Small"/>
                            </MudStack>
                        </MudPaper>
                    }
                    
                </MudStack>
            </MudDrawer>
       </Authorized>
    </AuthorizeView>

        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
                @Body
            </MudContainer>
        </MudMainContent>
</MudLayout>

@code{
    private bool drawerOpen = true;
    //Cambio el estado de la side bar
    private void ToggleDrawer() => drawerOpen = !drawerOpen;

    //Campos para el modo oscuro
    private MudThemeProvider themeProvider = null!;
    private bool isDarkMode;
    //Guardo el modo oscuro en memoria
    private async Task ToggleDarkMode()
    {
        isDarkMode = !isDarkMode;
        await storage.SetItemAsync("modoOscuro", isDarkMode.ToString());
    }


    //Veo si el usuario ya tiene alguna preferencia, sino, agarra del sistema
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var guardado = await storage.GetItemAsync("modoOscuro");
            if (!string.IsNullOrEmpty(guardado))
            {
                bool.TryParse(guardado, out isDarkMode);
            }
            else
            {
                isDarkMode = await themeProvider.GetSystemDarkModeAsync();
            }
            StateHasChanged();
        }
    }

    //Metodo para el logout
    private async Task CerrarSesion()
    {
        await auth.LogoutAsync();
        navigation.NavigateTo("/login");
    }
    
    private async Task GuardarModo()
        => await storage.SetItemAsync("modoOscuro", isDarkMode.ToString());
}